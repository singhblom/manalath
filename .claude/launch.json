{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "manalath",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--hot",
        "--env-file=.env.preview",
        "apps/server/src/index.ts"
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "docs"
      ],
      "port": 8766
    }
  ]
}
